DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
# Opcional: conexão sem pool usada apenas pelo Prisma CLI nas migrations
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
JWT_SECRET="gere-um-segredo-longo-e-aleatorio"
SECRETARY_INITIAL_PASSWORD="troque-esta-senha"
# RECEIPT mantém o cupom atual; A4 abre automaticamente a via de arquivo
REFUELING_VOUCHER_PRINT_FORMAT="RECEIPT"

# Cloudflare R2 (token restrito ao bucket, com leitura e escrita de objetos)
R2_ACCOUNT_ID="seu-account-id"
R2_ACCESS_KEY_ID="sua-access-key-id"
R2_SECRET_ACCESS_KEY="sua-secret-access-key"
R2_BUCKET_NAME="prefeitura-combustiveis"
# Domínio público personalizado ou URL r2.dev do bucket, sem barra no final
R2_PUBLIC_URL="https://arquivos.seudominio.gov.br"
