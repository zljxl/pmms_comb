generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum Role {
  DRIVER
  SECRETARY
  GOVERNMENT_SECRETARY
  MAYOR
  ADMIN
}

enum VehicleStatus {
  AVAILABLE
  IN_USE
  MAINTENANCE
  INACTIVE
}

enum SessionStatus {
  ACTIVE
  FINISHED
  CANCELLED
}

enum RefuelingStatus {
  WAITING_SECRETARY
  WAITING_GOVERNMENT
  WAITING_MAYOR
  APPROVED
  REJECTED
  RETURNED
}

enum ApprovalAction {
  APPROVED
  REJECTED
  RETURNED
}

model User {
  id                     Int              @id @default(autoincrement())
  matricula              String           @unique
  nome                   String
  passwordHash           String
  role                   Role
  secretariaId           Int?
  secretaria             Secretaria?      @relation("UsuariosSecretaria", fields: [secretariaId], references: [id])
  secretariasGerenciadas Secretaria[]     @relation("SecretarioResponsavel")
  ativo                  Boolean          @default(true)
  sessions               VehicleSession[]
  refuelings             Refueling[]
  approvals              Approval[]
  auditLogs              AuditLog[]
  createdStations        GasStation[]
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
}

model Secretaria {
  id              Int              @id @default(autoincrement())
  nome            String
  sigla           String?
  responsavelNome String?
  ativo           Boolean          @default(true)
  secretarioId    Int?
  secretario      User?            @relation("SecretarioResponsavel", fields: [secretarioId], references: [id])
  usuarios        User[]           @relation("UsuariosSecretaria")
  veiculos        Vehicle[]
  sessions        VehicleSession[]
  refuelings      Refueling[]
  quotas          FuelQuota[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model Vehicle {
  id           Int              @id @default(autoincrement())
  placa        String           @unique
  patrimonio   String?
  marca        String
  modelo       String
  ano          Int?
  fuelType     String?
  tankCapacity Float?
  currentKm    Int              @default(0)
  status       VehicleStatus    @default(AVAILABLE)
  secretariaId Int
  secretaria   Secretaria       @relation(fields: [secretariaId], references: [id])
  sessions     VehicleSession[]
  refuelings   Refueling[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
}

model VehicleSession {
  id             Int           @id @default(autoincrement())
  userId         Int
  user           User          @relation(fields: [userId], references: [id])
  vehicleId      Int
  vehicle        Vehicle       @relation(fields: [vehicleId], references: [id])
  secretariaId   Int
  secretaria     Secretaria    @relation(fields: [secretariaId], references: [id])
  startKm        Int
  endKm          Int?
  startPhoto     String?
  startLatitude  Float?
  startLongitude Float?
  endPhoto       String?
  endLatitude    Float?
  endLongitude   Float?
  startNote      String?
  endNote        String?
  status         SessionStatus @default(ACTIVE)
  startedAt      DateTime      @default(now())
  endedAt        DateTime?
  refuelings     Refueling[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([userId, status])
  @@index([vehicleId, status])
}

model Refueling {
  id            Int             @id @default(autoincrement())
  uid           String?         @default(cuid())
  externalCode  String?
  sessionId     Int?
  session       VehicleSession? @relation(fields: [sessionId], references: [id])
  userId        Int
  user          User            @relation(fields: [userId], references: [id])
  vehicleId     Int
  vehicle       Vehicle         @relation(fields: [vehicleId], references: [id])
  secretariaId  Int
  secretaria    Secretaria      @relation(fields: [secretariaId], references: [id])
  km            Int
  liters        Float
  pricePerLiter Float
  totalAmount   Float
  fuelType      String
  fuelStation   String?
  stationId     Int?
  station       GasStation?     @relation(fields: [stationId], references: [id])
  pumpPhoto     String?
  odometerPhoto String?
  receiptPhoto  String?
  voucherPdf    String?
  observation   String?
  status        RefuelingStatus @default(WAITING_SECRETARY)
  hasAlert      Boolean         @default(false)
  alertMessage  String?
  approvals     Approval[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([secretariaId, createdAt])
  @@index([status])
}

model GasStation {
  id             Int                    @id @default(autoincrement())
  name           String
  legalName      String?
  cnpj           String?
  phone          String?
  contractNumber String?
  address        String
  latitude       Float
  longitude      Float
  gasolinePrice  Float?
  ethanolPrice   Float?
  dieselPrice    Float?
  active         Boolean                @default(true)
  createdById    Int
  createdBy      User                   @relation(fields: [createdById], references: [id])
  refuelings     Refueling[]
  allowances     StationFuelAllowance[]
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@index([active, name])
}

model StationFuelAllowance {
  id          Int        @id @default(autoincrement())
  stationId   Int
  station     GasStation @relation(fields: [stationId], references: [id])
  year        Int
  month       Int
  litersLimit Float
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([stationId, year, month])
}

model Approval {
  id          Int            @id @default(autoincrement())
  refuelingId Int
  refueling   Refueling      @relation(fields: [refuelingId], references: [id])
  userId      Int
  user        User           @relation(fields: [userId], references: [id])
  role        Role
  action      ApprovalAction
  observation String?
  createdAt   DateTime       @default(now())
}

model FuelQuota {
  id             Int        @id @default(autoincrement())
  secretariaId   Int
  secretaria     Secretaria @relation(fields: [secretariaId], references: [id])
  year           Int
  month          Int
  dieselS10Limit Float      @default(0)
  gasolineLimit  Float      @default(0)
  amountLimit    Float
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@unique([secretariaId, year, month])
}

model MunicipalFuelQuota {
  id          Int      @id @default(autoincrement())
  year        Int
  month       Int
  amountLimit Float
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([year, month])
}

model AuditLog {
  id          Int      @id @default(autoincrement())
  userId      Int?
  user        User?    @relation(fields: [userId], references: [id])
  action      String
  entity      String
  entityId    String?
  description String?
  oldData     String?
  newData     String?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
  @@index([entity, entityId])
}
